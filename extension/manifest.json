{
  "manifest_version": 3,
  "name": "Local Stream Subtitles",
  "version": "0.2.0",
  "description": "Local Japanese-to-English subtitles for YouTube videos, live streams, and Vimeo videos.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://vimeo.com/*",
    "https://www.vimeo.com/*",
    "https://player.vimeo.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Local Stream Subtitles",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vimeo.com/*",
        "https://www.vimeo.com/*",
        "https://player.vimeo.com/video/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
